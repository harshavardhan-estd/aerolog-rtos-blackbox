{
  "version": 1,
  "author": "Harshavardhan (AeroLog-RTOS)",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "mcu", "top": 0, "left": 0, "attrs": {} },
    { "type": "board-mpu6050", "id": "imu", "top": -160, "left": 180, "attrs": {} },
    { "type": "wokwi-led", "id": "led_health", "top": 120, "left": -120, "attrs": { "color": "green", "label": "SYS HEALTH" } },
    { "type": "wokwi-led", "id": "led_flash", "top": 170, "left": -120, "attrs": { "color": "blue", "label": "FLASH ACTIVE" } },
    { "type": "wokwi-led", "id": "led_brownout", "top": 220, "left": -120, "attrs": { "color": "red", "label": "BROWNOUT ALERT" } },
    { "type": "wokwi-pushbutton", "id": "btn_brownout", "top": 120, "left": 220, "attrs": { "color": "red", "label": "BROWNOUT IRQ" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 120, "left": -70, "attrs": { "value": "330" } },
    { "type": "wokwi-resistor", "id": "r2", "top": 170, "left": -70, "attrs": { "value": "330" } },
    { "type": "wokwi-resistor", "id": "r3", "top": 220, "left": -70, "attrs": { "value": "330" } }
  ],
  "connections": [
    [ "mcu:GND.1", "imu:GND", "black", [ "v0" ] ],
    [ "mcu:3V3", "imu:VCC", "red", [ "v0" ] ],
    [ "mcu:22", "imu:SCL", "yellow", [ "v0" ] ],
    [ "mcu:21", "imu:SDA", "green", [ "v0" ] ],

    [ "mcu:1", "r1:1", "green", [ "v0" ] ],
    [ "r1:2", "led_health:A", "green", [ "v0" ] ],
    [ "led_health:C", "mcu:GND.1", "black", [ "v0" ] ],

    [ "mcu:12", "r2:1", "blue", [ "v0" ] ],
    [ "r2:2", "led_flash:A", "blue", [ "v0" ] ],
    [ "led_flash:C", "mcu:GND.1", "black", [ "v0" ] ],

    [ "mcu:13", "r3:1", "red", [ "v0" ] ],
    [ "r3:2", "led_brownout:A", "red", [ "v0" ] ],
    [ "led_brownout:C", "mcu:GND.1", "black", [ "v0" ] ],

    [ "mcu:0", "btn_brownout:1.l", "red", [ "v0" ] ],
    [ "btn_brownout:2.l", "mcu:GND.1", "black", [ "v0" ] ]
  ]
}
